---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { listJournalEntries } from '../lib/database/journal';
import type { JournalEntry } from '../types/database';
import { env } from 'cloudflare:workers';

export const prerender = false;

const loadEntries = async (): Promise<{
	entries: JournalEntry[];
	isDatabaseAvailable: boolean;
}> => {
	const db = env.DB as D1Database | undefined;
	if (!db) return { entries: [], isDatabaseAvailable: false };

	try {
		const entries = await listJournalEntries(db, {
			includeDrafts: false,
			limit: 50,
		});
		return { entries, isDatabaseAvailable: true };
	} catch (error) {
		console.error('Failed to load journal entries.', error);
		return { entries: [], isDatabaseAvailable: false };
	}
};

const { entries, isDatabaseAvailable } = await loadEntries();
const formatDate = new Intl.DateTimeFormat('zh-TW', {
	dateStyle: 'medium',
});
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`研究筆記 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />

		<style>
			main {
				width: 100%;
				max-width: 1000px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.page-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 3.5rem;
				font-weight: 800;
				letter-spacing: 0;
			}

			.page-desc {
				max-width: 720px;
				margin: 0 0 24px;
				color: #666;
				font-size: 1.1rem;
				line-height: 1.8;
			}

			.page-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 40px;
			}

			.action-link {
				display: inline-flex;
				align-items: center;
				padding: 10px 16px;
				border: 1px solid #e5e7eb;
				border-radius: 999px;
				background: #fff;
				color: #333;
				font-size: 0.95rem;
				font-weight: 700;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					transform 0.2s ease;
			}

			.action-link:hover {
				background: #f3f4f6;
				border-color: #d1d5db;
				transform: translateY(-2px);
			}

			.entry-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 20px;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.entry-card,
			.empty-state {
				border: 1px solid #eee;
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
			}

			.entry-card {
				display: flex;
				flex-direction: column;
				gap: 16px;
				height: 100%;
				padding: 24px;
			}

			.entry-title {
				margin: 0;
				color: #111;
				font-size: 1.35rem;
				line-height: 1.45;
			}

			.entry-title a {
				color: inherit;
				text-decoration: none;
			}

			.entry-title a:hover {
				color: #666;
			}

			.entry-summary {
				margin: 0;
				color: #555;
				line-height: 1.75;
			}

			.entry-meta,
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				padding: 7px 10px;
				font-size: 0.8rem;
				font-weight: 700;
				line-height: 1;
			}

			.pill-dark {
				background: #111;
				color: #fff;
			}

			.pill-light {
				background: #f3f4f6;
				color: #444;
			}

			.entry-date {
				margin: auto 0 0;
				color: #777;
				font-size: 0.9rem;
			}

			.empty-state {
				padding: 28px;
				color: #666;
				line-height: 1.8;
			}

			@media (max-width: 720px) {
				.page-title {
					font-size: 2.45rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<h1 class="page-title">研究筆記</h1>
			<p class="page-desc">
				用比較自由的方式記錄每日研究、計算條件、圖片、觀察與下一步想法。
			</p>

			<div class="page-actions">
				<a href="/journal/admin/" class="action-link">撰寫日誌</a>
				<a href="/blog" class="action-link">學習日誌</a>
				<a href="/dashboard" class="action-link">回到儀表板</a>
			</div>

			{
				!isDatabaseAvailable ? (
					<p class="empty-state">
						D1 資料庫目前不可用。設定 Cloudflare D1 後即可顯示研究筆記。
					</p>
				) : entries.length > 0 ? (
					<ul class="entry-list">
						{entries.map((entry) => (
							<li>
								<article class="entry-card">
									<div class="entry-meta">
										<span class="pill pill-dark">{entry.category}</span>
										{entry.tags.map((tag) => (
											<span class="pill pill-light">{tag}</span>
										))}
									</div>

									<h2 class="entry-title">
										<a href={`/journal/${entry.slug}/`}>{entry.title}</a>
									</h2>
									<p class="entry-summary">
										{entry.summary || '這篇筆記尚未填寫摘要。'}
									</p>
									<p class="entry-date">
										{formatDate.format(new Date(entry.entry_date))}
									</p>
								</article>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">
						目前還沒有已發布的研究筆記。本人登入後可以先到撰寫頁建立草稿。
					</p>
				)
			}
		</main>

		<Footer />
	</body>
</html>
