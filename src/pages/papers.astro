---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { readAuthSession } from '../lib/auth/session';
import { listPapers } from '../lib/database/papers';
import type { Paper, PaperReadingStatus } from '../types/database';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = await readAuthSession(Astro.request, env.SESSION_SECRET);
const isOwner = session?.role === 'owner';

const statusLabels = {
	to_read: '待閱讀',
	reading: '閱讀中',
	finished: '已讀完',
	important: '重要文獻',
} satisfies Record<PaperReadingStatus, string>;

const loadPapers = async (): Promise<{
	dbAvailable: boolean;
	papers: Paper[];
}> => {
	const db = env.DB as D1Database | undefined;
	if (!db) return { dbAvailable: false, papers: [] };

	try {
		const papers = await listPapers(db, {
			includePrivate: isOwner,
			limit: 200,
		});

		return { dbAvailable: true, papers };
	} catch (error) {
		console.error('Failed to load D1 paper library.', error);
		return { dbAvailable: false, papers: [] };
	}
};

const { dbAvailable, papers } = await loadPapers();
const analysisCount = papers.reduce(
	(total, paper) => total + paper.analyses.length,
	0,
);
const stats = [
	{ label: '收藏文獻', value: papers.length },
	{
		label: '閱讀中',
		value: papers.filter((paper) => paper.reading_status === 'reading').length,
	},
	{
		label: '重要文獻',
		value: papers.filter((paper) => paper.reading_status === 'important').length,
	},
	{ label: '已存分析', value: analysisCount },
];

const formatAuthors = (authors: string[]) => {
	if (authors.length === 0) return '作者未記錄';
	if (authors.length <= 3) return authors.join(', ');

	return `${authors.slice(0, 3).join(', ')} et al.`;
};

const truncate = (value: string, maxLength: number) =>
	value.length > maxLength ? `${value.slice(0, maxLength).trim()}...` : value;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`我的文獻庫 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />

		<style>
			main {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.page-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 3.4rem;
				font-weight: 800;
				letter-spacing: 0;
			}

			.page-desc {
				max-width: 760px;
				margin: 0 0 24px;
				color: #666;
				font-size: 1.08rem;
				line-height: 1.8;
			}

			.page-actions,
			.filter-row,
			.meta-row,
			.card-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}

			.page-actions {
				margin-bottom: 34px;
			}

			.action-link,
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 42px;
				padding: 10px 16px;
				border: 1px solid #e5e7eb;
				border-radius: 999px;
				background: #fff;
				color: #333;
				font: inherit;
				font-size: 0.94rem;
				font-weight: 700;
				text-decoration: none;
				cursor: pointer;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
			}

			.action-link:hover,
			.button:hover {
				background: #f3f4f6;
				border-color: #d1d5db;
				transform: translateY(-2px);
			}

			.button-primary {
				background: #111;
				border-color: #111;
				color: #fff;
			}

			.button-primary:hover {
				background: #333;
				border-color: #333;
			}

			.status-message {
				margin: 0 0 22px;
				padding: 12px 14px;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #f9fafb;
				color: #444;
				font-size: 0.92rem;
				line-height: 1.6;
			}

			.status-message.error {
				border-color: #e5c7c7;
				background: #fff7f7;
				color: #7a2626;
			}

			.stat-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 16px;
				margin-bottom: 34px;
			}

			.stat-card,
			.paper-card,
			.empty-state {
				border: 1px solid #eee;
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
			}

			.stat-card {
				padding: 20px;
			}

			.stat-value {
				display: block;
				margin-bottom: 8px;
				color: #111;
				font-size: 2rem;
				font-weight: 800;
				line-height: 1;
			}

			.stat-label {
				color: #666;
				font-size: 0.9rem;
				font-weight: 700;
			}

			.toolbar {
				margin-bottom: 22px;
				padding: 18px;
				border: 1px solid #eee;
				border-radius: 8px;
				background: #fff;
			}

			.filter-row {
				align-items: center;
			}

			input,
			select,
			textarea {
				width: 100%;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #fff;
				color: #111;
				font: inherit;
				font-size: 0.94rem;
				line-height: 1.5;
			}

			input,
			select {
				min-height: 42px;
				padding: 9px 12px;
			}

			textarea {
				min-height: 112px;
				padding: 11px 12px;
				resize: vertical;
			}

			input:focus,
			select:focus,
			textarea:focus {
				outline: 2px solid #111;
				outline-offset: 2px;
				border-color: #111;
			}

			.library-search {
				flex: 1;
				min-width: 240px;
				border-radius: 999px;
				padding: 11px 16px;
			}

			.status-filter {
				width: auto;
				min-width: 170px;
				border-radius: 999px;
				padding: 10px 14px;
			}

			.paper-list {
				display: grid;
				gap: 22px;
			}

			.paper-card {
				padding: 24px;
			}

			.paper-header {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				margin-bottom: 16px;
			}

			.paper-title {
				margin: 0 0 9px;
				color: #111;
				font-size: 1.35rem;
				line-height: 1.38;
			}

			.paper-title a {
				color: inherit;
				text-decoration: none;
			}

			.paper-title a:hover {
				color: #666;
			}

			.paper-meta,
			.paper-abstract,
			.paper-notes,
			.analysis-content,
			.empty-state {
				color: #555;
				line-height: 1.75;
			}

			.paper-meta,
			.paper-abstract,
			.paper-notes {
				margin: 0 0 16px;
			}

			.score-badge {
				flex: 0 0 auto;
				min-width: 76px;
				border-radius: 8px;
				background: #111;
				color: #fff;
				padding: 12px 14px;
				text-align: center;
			}

			.score-number {
				display: block;
				font-size: 1.45rem;
				font-weight: 800;
				line-height: 1;
			}

			.score-label {
				display: block;
				margin-top: 4px;
				font-size: 0.74rem;
				opacity: 0.78;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				background: #f3f4f6;
				color: #444;
				padding: 7px 10px;
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1;
			}

			.pill-dark {
				background: #111;
				color: #fff;
			}

			.analysis-list {
				display: grid;
				gap: 10px;
				margin: 18px 0;
			}

			.analysis-details {
				border: 1px solid #eee;
				border-radius: 8px;
				background: #fafafa;
			}

			.analysis-details summary {
				padding: 12px 14px;
				color: #111;
				font-weight: 800;
				cursor: pointer;
			}

			.analysis-content {
				max-height: 340px;
				overflow: auto;
				margin: 0;
				padding: 0 14px 14px;
				white-space: pre-wrap;
				font: inherit;
				font-size: 0.9rem;
			}

			.owner-panel {
				display: grid;
				gap: 14px;
				margin-top: 18px;
				padding-top: 18px;
				border-top: 1px solid #eee;
			}

			.owner-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 12px;
			}

			.field {
				display: grid;
				gap: 7px;
			}

			label {
				color: #333;
				font-size: 0.86rem;
				font-weight: 800;
			}

			.card-status {
				margin: 0;
				color: #666;
				font-size: 0.9rem;
				font-weight: 700;
			}

			.empty-state {
				margin: 0;
				padding: 24px;
			}

			[hidden] {
				display: none !important;
			}

			@media (max-width: 820px) {
				.stat-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.owner-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				main {
					padding: 32px 18px;
				}

				.page-title {
					font-size: 2.45rem;
				}

				.paper-header,
				.filter-row {
					flex-direction: column;
					align-items: stretch;
				}

				.status-filter {
					width: 100%;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main data-owner={String(isOwner)}>
			<h1 class="page-title">我的文獻庫</h1>
			<p class="page-desc">
				保存想繼續追的論文、閱讀狀態、個人筆記與本地分析結果，讓搜尋到的文獻能累積成自己的研究資料庫。
			</p>

			<div class="page-actions">
				<a href="/literature" class="action-link">回到文獻搜尋</a>
				<a href="/dashboard" class="action-link">回到儀表板</a>
				{
					!isOwner && (
						<a href="/login?next=/papers" class="action-link">
							本人登入
						</a>
					)
				}
			</div>

			{
				!dbAvailable && (
					<p class="status-message error">
						目前無法讀取 D1 文獻庫，請確認 Cloudflare D1 綁定與 schema 已完成。
					</p>
				)
			}

			{
				!isOwner && (
					<p class="status-message">
						訪客目前只會看到公開文獻；本人登入後可以查看私人收藏、更新閱讀狀態與編輯筆記。
					</p>
				)
			}

			<div class="stat-grid" aria-label="文獻庫摘要">
				{
					stats.map((stat) => (
						<article class="stat-card">
							<span class="stat-value">{stat.value}</span>
							<span class="stat-label">{stat.label}</span>
						</article>
					))
				}
			</div>

			<section class="toolbar" aria-label="文獻庫篩選">
				<div class="filter-row">
					<input
						type="search"
						id="librarySearch"
						class="library-search"
						placeholder="搜尋標題、作者、期刊、摘要、標籤"
					/>
					<select id="statusFilter" class="status-filter">
						<option value="all">全部狀態</option>
						<option value="to_read">待閱讀</option>
						<option value="reading">閱讀中</option>
						<option value="finished">已讀完</option>
						<option value="important">重要文獻</option>
					</select>
				</div>
			</section>

			<section aria-labelledby="paperListTitle">
				<h2 class="page-title" id="paperListTitle" style="font-size: 1.8rem; margin-bottom: 18px;">
					收藏清單
				</h2>

				<div class="paper-list" id="paperList">
					{
						papers.length > 0 ? (
							papers.map((paper) => (
								<article
									class="paper-card"
									data-paper-card
									data-paper-id={paper.id}
									data-status={paper.reading_status}
									data-search={[
										paper.title,
										formatAuthors(paper.authors),
										paper.journal,
										paper.abstract,
										paper.citation,
										paper.notes,
										paper.tags.join(' '),
									]
										.join(' ')
										.toLowerCase()}
								>
									<header class="paper-header">
										<div>
											<h3 class="paper-title">
												{paper.url ? (
													<a href={paper.url} target="_blank" rel="noreferrer">
														{paper.title}
													</a>
												) : (
													paper.title
												)}
											</h3>
											<p class="paper-meta">
												{formatAuthors(paper.authors)} ·{' '}
												{paper.publication_year ?? '年份未記錄'} ·{' '}
												{paper.journal || '期刊未記錄'}
											</p>
										</div>
										<div class="score-badge" aria-label={`引用 ${paper.cited_by_count} 次`}>
											<span class="score-number">{paper.cited_by_count}</span>
											<span class="score-label">Citations</span>
										</div>
									</header>

									<div class="meta-row">
										<span class="pill pill-dark">
											{statusLabels[paper.reading_status]}
										</span>
										<span class="pill">{paper.visibility === 'private' ? '私人' : '公開'}</span>
										{paper.is_open_access ? <span class="pill">Open Access</span> : null}
										{paper.doi ? <span class="pill">DOI</span> : null}
										{paper.tags.map((tag) => (
											<span class="pill">{tag}</span>
										))}
									</div>

									<p class="paper-abstract">
										{paper.abstract
											? truncate(paper.abstract, 720)
											: '這篇文獻尚未保存摘要。'}
									</p>

									{paper.notes ? (
										<p class="paper-notes">
											<strong>我的筆記：</strong>
											{truncate(paper.notes, 420)}
										</p>
									) : null}

									{paper.analyses.length > 0 ? (
										<div class="analysis-list">
											{paper.analyses.slice(0, 3).map((analysis) => (
												<details class="analysis-details">
													<summary>
														{analysis.analysis_title || analysis.analysis_mode}
													</summary>
													<pre class="analysis-content">{analysis.analysis_markdown}</pre>
												</details>
											))}
										</div>
									) : null}

									<div class="card-actions">
										{paper.url ? (
											<a class="action-link" href={paper.url} target="_blank" rel="noreferrer">
												開啟論文
											</a>
										) : null}
										<a class="action-link" href={`/literature?title=${encodeURIComponent(paper.title)}`}>
											回到分析器
										</a>
									</div>

									{
										isOwner && (
											<form class="owner-panel" data-paper-form>
												<div class="owner-grid">
													<div class="field">
														<label for={`status-${paper.id}`}>閱讀狀態</label>
														<select
															id={`status-${paper.id}`}
															name="reading_status"
														>
															<option value="to_read" selected={paper.reading_status === 'to_read'}>
																待閱讀
															</option>
															<option value="reading" selected={paper.reading_status === 'reading'}>
																閱讀中
															</option>
															<option value="finished" selected={paper.reading_status === 'finished'}>
																已讀完
															</option>
															<option value="important" selected={paper.reading_status === 'important'}>
																重要文獻
															</option>
														</select>
													</div>
													<div class="field">
														<label for={`visibility-${paper.id}`}>可見性</label>
														<select id={`visibility-${paper.id}`} name="visibility">
															<option value="private" selected={paper.visibility === 'private'}>
																私人
															</option>
															<option value="public" selected={paper.visibility === 'public'}>
																公開
															</option>
														</select>
													</div>
													<div class="field">
														<label for={`tags-${paper.id}`}>標籤</label>
														<input
															id={`tags-${paper.id}`}
															name="tags"
															type="text"
															value={paper.tags.join(', ')}
														/>
													</div>
												</div>
												<div class="field">
													<label for={`notes-${paper.id}`}>我的筆記</label>
													<textarea id={`notes-${paper.id}`} name="notes">{paper.notes}</textarea>
												</div>
												<div class="card-actions">
													<button type="submit" class="button button-primary">
														儲存更新
													</button>
													<p class="card-status" data-form-status></p>
												</div>
											</form>
										)
									}
								</article>
							))
						) : (
							<p class="empty-state" id="emptyState">
								目前還沒有可顯示的收藏文獻。可以先到文獻搜尋頁找 paper，再把想繼續看的項目存進來。
							</p>
						)
					}
				</div>

				<p class="empty-state" id="filterEmptyState" hidden>
					目前篩選條件下沒有符合的文獻。
				</p>
			</section>
		</main>

		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const searchInput = document.querySelector('#librarySearch');
				const statusFilter = document.querySelector('#statusFilter');
				const cards = [...document.querySelectorAll('[data-paper-card]')];
				const filterEmptyState = document.querySelector('#filterEmptyState');
				const isOwner = document.querySelector('main')?.dataset.owner === 'true';

				if (!(searchInput instanceof HTMLInputElement)) return;
				if (!(statusFilter instanceof HTMLSelectElement)) return;

				const splitTags = (value) =>
					value
						.split(',')
						.map((tag) => tag.trim())
						.filter((tag, index, list) => tag && list.indexOf(tag) === index);

				const updateVisibility = () => {
					const searchTerm = searchInput.value.trim().toLowerCase();
					const status = statusFilter.value;
					let visibleCount = 0;

					for (const card of cards) {
						const matchesSearch = (card.dataset.search || '').includes(searchTerm);
						const matchesStatus = status === 'all' || card.dataset.status === status;
						const isVisible = matchesSearch && matchesStatus;
						card.hidden = !isVisible;
						if (isVisible) visibleCount += 1;
					}

					if (filterEmptyState instanceof HTMLElement) {
						filterEmptyState.hidden = visibleCount > 0 || cards.length === 0;
					}
				};

				searchInput.addEventListener('input', updateVisibility);
				statusFilter.addEventListener('change', updateVisibility);

				if (!isOwner) return;

				document.querySelectorAll('[data-paper-form]').forEach((form) => {
					if (!(form instanceof HTMLFormElement)) return;
					const card = form.closest('[data-paper-card]');
					const status = form.querySelector('[data-form-status]');
					if (!(card instanceof HTMLElement)) return;

					form.addEventListener('submit', async (event) => {
						event.preventDefault();
						const paperId = card.dataset.paperId;
						if (!paperId) return;

						const data = new FormData(form);
						if (status instanceof HTMLElement) status.textContent = '儲存中。';

						try {
							const response = await fetch(`/api/admin/papers/${paperId}`, {
								method: 'PATCH',
								headers: { 'content-type': 'application/json' },
								body: JSON.stringify({
									reading_status: String(data.get('reading_status') || 'to_read'),
									visibility: String(data.get('visibility') || 'private'),
									tags: splitTags(String(data.get('tags') || '')),
									notes: String(data.get('notes') || ''),
								}),
							});

							const result = await response.json();
							if (!response.ok || !result.ok) {
								throw new Error('Save failed.');
							}

							card.dataset.status = result.paper.reading_status;
							if (status instanceof HTMLElement) status.textContent = '已儲存。';
							updateVisibility();
						} catch {
							if (status instanceof HTMLElement) {
								status.textContent = '儲存失敗，請確認已登入本人帳號。';
							}
						}
					});
				});
			});
		</script>
	</body>
</html>
