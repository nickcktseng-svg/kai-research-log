---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import jsonReports from '../data/weekly-reports.json';
import { readAuthSession } from '../lib/auth/session';
import { listJournalEntries } from '../lib/database/journal';
import { listPapers } from '../lib/database/papers';
import { listDatabaseTasks } from '../lib/database/tasks';
import { listDatabaseWeeklyReports } from '../lib/database/weekly-reports';
import { buildWeeklyOutline } from '../lib/weekly/outline';
import type { WeeklyOutline } from '../lib/weekly/outline';
import type {
	JournalEntry,
	Paper,
	TaskWithTags,
	WeeklyReportWithSections,
} from '../types/database';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = await readAuthSession(Astro.request, env.SESSION_SECRET);
const isOwner = session?.role === 'owner';

type JsonWeeklyReport = (typeof jsonReports)[number];

type WeeklyReportView = {
	id: string;
	week: string;
	title: string;
	dateRange: string;
	summary: string;
	completed: string[];
	progress: string[];
	problems: string[];
	solutions: string[];
	unfinished: string[];
	next: string[];
	categories: string[];
	tags: string[];
};

const normalizeJsonReport = (report: JsonWeeklyReport): WeeklyReportView => report;

const normalizeDatabaseReport = (
	report: WeeklyReportWithSections,
): WeeklyReportView => ({
	id: report.id,
	week: report.week,
	title: report.title,
	dateRange: report.date_range,
	summary: report.summary,
	completed: report.completed,
	progress: report.progress,
	problems: report.problems,
	solutions: report.solutions,
	unfinished: report.unfinished,
	next: report.next,
	categories: report.categories,
	tags: report.tags,
});

const loadWeeklyData = async (): Promise<{
	journals: JournalEntry[];
	papers: Paper[];
	reports: WeeklyReportView[];
	tasks: TaskWithTags[];
}> => {
	const db = env.DB as D1Database | undefined;
	if (!db) {
		return {
			journals: [],
			papers: [],
			reports: jsonReports.map(normalizeJsonReport),
			tasks: [],
		};
	}

	try {
		const [databaseTasks, databaseReports, journals, papers] = await Promise.all([
			listDatabaseTasks(db),
			listDatabaseWeeklyReports(db),
			listJournalEntries(db, { includeDrafts: false, limit: 100 }),
			listPapers(db, { includePrivate: isOwner, limit: 100 }),
		]);

		return {
			journals,
			papers,
			reports: databaseReports.map(normalizeDatabaseReport),
			tasks: databaseTasks,
		};
	} catch (error) {
		console.error('Failed to load D1 weekly data. Falling back to JSON reports.', error);
		return {
			journals: [],
			papers: [],
			reports: jsonReports.map(normalizeJsonReport),
			tasks: [],
		};
	}
};

const { journals, papers, reports, tasks } = await loadWeeklyData();
const outline: WeeklyOutline = buildWeeklyOutline({ journals, papers, tasks });
const sortedReports = [...reports].sort((a, b) => b.week.localeCompare(a.week));

const reportSections = [
	{ key: 'completed', title: '完成事項' },
	{ key: 'progress', title: '研究進度' },
	{ key: 'problems', title: '遇到的問題' },
	{ key: 'solutions', title: '解決方式' },
	{ key: 'unfinished', title: '尚未完成' },
	{ key: 'next', title: '下週目標' },
] as const;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`研究週報 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />

		<style>
			main {
				width: 100%;
				max-width: 1000px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.page-title {
				font-size: 3.5rem;
				font-weight: 800;
				margin-bottom: 10px;
				letter-spacing: -0.02em;
				color: #111;
			}

			.page-desc {
				color: #666;
				font-size: 1.1rem;
				margin-bottom: 24px;
				max-width: 720px;
			}

			.page-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 40px;
			}

			.action-link {
				display: inline-flex;
				align-items: center;
				padding: 10px 16px;
				border: 1px solid #e5e7eb;
				border-radius: 999px;
				background: #fff;
				color: #333;
				font-size: 0.95rem;
				font-weight: 700;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					transform 0.2s ease;
			}

			.action-link:hover {
				background: #f3f4f6;
				border-color: #d1d5db;
				transform: translateY(-2px);
			}

			.outline-section {
				margin-bottom: 42px;
			}

			.section-title {
				margin: 0 0 16px;
				color: #111;
				font-size: 1.7rem;
			}

			.report-list {
				display: grid;
				gap: 24px;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.report-card {
				padding: 28px;
				border: 1px solid #eee;
				border-radius: 16px;
				background: #fff;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
			}

			.report-header {
				display: flex;
				justify-content: space-between;
				gap: 20px;
				margin-bottom: 20px;
			}

			.report-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 1.6rem;
				line-height: 1.4;
			}

			.report-date {
				margin: 0;
				color: #777;
				font-size: 0.95rem;
			}

			.week-pill {
				align-self: flex-start;
				border-radius: 999px;
				background: #111;
				color: #fff;
				padding: 8px 12px;
				font-size: 0.85rem;
				font-weight: 700;
				line-height: 1;
			}

			.summary {
				margin: 0 0 28px;
				color: #444;
				font-size: 1rem;
				line-height: 1.8;
			}

			.report-sections {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 24px 28px;
				margin-bottom: 24px;
			}

			.report-section-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 1rem;
			}

			.report-section-list {
				margin: 0;
				padding-left: 1.2rem;
				color: #555;
				line-height: 1.75;
			}

			.report-section-list li + li {
				margin-top: 6px;
			}

			.meta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				padding-top: 20px;
				border-top: 1px solid #eee;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				background: #f3f4f6;
				color: #444;
				padding: 7px 10px;
				font-size: 0.8rem;
				font-weight: 600;
				line-height: 1;
			}

			.pill-dark {
				background: #111;
				color: #fff;
			}

			@media (max-width: 720px) {
				.page-title {
					font-size: 2.5rem;
				}

				.report-card {
					padding: 22px;
				}

				.report-header {
					flex-direction: column;
				}

				.report-sections {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<h1 class="page-title">研究週報</h1>
			<p class="page-desc">
				每週整理完成事項、研究進度、遇到的問題與下一步目標。
			</p>

			<div class="page-actions">
				<a href="/tasks" class="action-link">查看任務</a>
				<a href="/journal" class="action-link">查看研究筆記</a>
				<a href="/papers" class="action-link">查看文獻庫</a>
				<a href="/dashboard" class="action-link">回到儀表板</a>
			</div>

			<section class="outline-section" aria-labelledby="autoOutlineTitle">
				<h2 class="section-title" id="autoOutlineTitle">本週自動大綱</h2>
				<article class="report-card">
					<header class="report-header">
						<div>
							<h3 class="report-title">{outline.title}</h3>
							<p class="report-date">{outline.dateRange}</p>
						</div>
						<span class="week-pill">{outline.week}</span>
					</header>

					<p class="summary">{outline.summary}</p>

					<div class="report-sections">
						{reportSections.map((section) => (
							<section>
								<h4 class="report-section-title">
									{section.title}
								</h4>
								<ul class="report-section-list">
									{outline[section.key].map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</section>
						))}
					</div>

					<div class="meta-row">
						<span class="pill pill-dark">自動整理</span>
						{outline.categories.map((category) => (
							<span class="pill">{category}</span>
						))}
						{outline.tags.map((tag) => (
							<span class="pill">{tag}</span>
						))}
					</div>
				</article>
			</section>

			<h2 class="section-title">已儲存週報</h2>
			<ul class="report-list">
				{
					sortedReports.map((report) => (
						<li>
							<article class="report-card">
								<header class="report-header">
									<div>
										<h2 class="report-title">
											{report.title}
										</h2>
										<p class="report-date">
											{report.dateRange}
										</p>
									</div>
									<span class="week-pill">{report.week}</span>
								</header>

								<p class="summary">{report.summary}</p>

								<div class="report-sections">
									{reportSections.map((section) => (
										<section>
											<h3 class="report-section-title">
												{section.title}
											</h3>
											<ul class="report-section-list">
												{report[section.key].map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</section>
									))}
								</div>

								<div class="meta-row">
									{report.categories.map((category) => (
										<span class="pill">{category}</span>
									))}
									{report.tags.map((tag) => (
										<span class="pill">{tag}</span>
									))}
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</main>

		<Footer />
	</body>
</html>
