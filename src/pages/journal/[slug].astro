---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getJournalEntryBySlug } from '../../lib/database/journal';
import type { JournalEntry } from '../../types/database';
import { env } from 'cloudflare:workers';

export const prerender = false;

const loadEntry = async (): Promise<JournalEntry | null> => {
	const db = env.DB as D1Database | undefined;
	const slug = Astro.params.slug ?? '';
	if (!db || !slug) return null;

	try {
		return await getJournalEntryBySlug(db, slug, { includeDrafts: false });
	} catch (error) {
		console.error('Failed to load journal entry.', error);
		return null;
	}
};

const entry = await loadEntry();
if (!entry) {
	return Astro.redirect('/journal');
}

const formatDate = new Intl.DateTimeFormat('zh-TW', {
	dateStyle: 'medium',
});
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`${entry.title} | ${SITE_TITLE}`} description={entry.summary} />

		<style>
			main {
				width: 100%;
				max-width: 860px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				margin-bottom: 26px;
				color: #555;
				font-weight: 700;
				text-decoration: none;
			}

			.back-link:hover {
				color: #111;
			}

			.entry-header {
				margin-bottom: 38px;
				padding-bottom: 26px;
				border-bottom: 1px solid #eee;
			}

			.page-title {
				margin: 0 0 16px;
				color: #111;
				font-size: 3rem;
				font-weight: 800;
				letter-spacing: 0;
				line-height: 1.15;
				overflow-wrap: anywhere;
			}

			.page-summary {
				max-width: 760px;
				margin: 0 0 18px;
				color: #555;
				font-size: 1.08rem;
				line-height: 1.8;
				overflow-wrap: break-word;
			}

			.entry-meta,
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				min-width: 0;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				padding: 7px 10px;
				font-size: 0.8rem;
				font-weight: 700;
				line-height: 1.2;
				max-width: 100%;
				overflow-wrap: anywhere;
			}

			.pill-dark {
				background: #111;
				color: #fff;
			}

			.pill-light {
				background: #f3f4f6;
				color: #444;
			}

			.entry-date {
				color: #777;
				font-size: 0.95rem;
			}

			.entry-content {
				color: #222;
				font-size: 1.05rem;
				line-height: 1.85;
				overflow-wrap: break-word;
			}

			.entry-content :global(h2),
			.entry-content :global(h3) {
				margin: 2em 0 0.7em;
				color: #111;
				line-height: 1.3;
			}

			.entry-content :global(p),
			.entry-content :global(ul),
			.entry-content :global(ol),
			.entry-content :global(blockquote),
			.entry-content :global(figure) {
				margin: 0 0 1.25em;
			}

			.entry-content :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				border: 1px solid #eee;
				border-radius: 8px;
			}

			.entry-content :global(figcaption) {
				margin-top: 8px;
				color: #777;
				font-size: 0.9rem;
				text-align: center;
			}

			.entry-content :global(blockquote) {
				border-left: 3px solid #111;
				padding-left: 16px;
				color: #555;
			}

			.entry-content :global(pre),
			.entry-content :global(table) {
				max-width: 100%;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
			}

			@media (max-width: 720px) {
				main {
					padding: 32px 16px;
				}

				.entry-header {
					margin-bottom: 30px;
					padding-bottom: 22px;
				}

				.page-title {
					font-size: 2rem;
					line-height: 1.18;
				}

				.page-summary,
				.entry-content {
					font-size: 1rem;
					line-height: 1.78;
				}
			}

			@media (max-width: 360px) {
				main {
					padding-right: 14px;
					padding-left: 14px;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<a href="/journal" class="back-link">返回研究筆記</a>

			<header class="entry-header">
				<h1 class="page-title">{entry.title}</h1>
				<p class="page-summary">{entry.summary}</p>
				<div class="entry-meta">
					<span class="pill pill-dark">{entry.category}</span>
					<span class="pill pill-light">{formatDate.format(new Date(entry.entry_date))}</span>
					{entry.tags.map((tag) => (
						<span class="pill pill-light">{tag}</span>
					))}
				</div>
			</header>

			<article class="entry-content" set:html={entry.content_html} />
		</main>

		<Footer />
	</body>
</html>
