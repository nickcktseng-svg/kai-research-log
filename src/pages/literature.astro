---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead
			title={`文獻總結系統 | ${SITE_TITLE}`}
			description="搜尋、上傳與整理學術文獻"
		/>

		<style>
			main {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.page-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 3.5rem;
				font-weight: 800;
				letter-spacing: 0;
				overflow-wrap: anywhere;
			}

			.page-desc {
				max-width: 760px;
				margin: 0 0 22px;
				color: #666;
				font-size: 1.1rem;
				line-height: 1.8;
			}

			.page-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 34px;
			}

			.section {
				margin-bottom: 56px;
			}

			.section-heading {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 16px;
				margin-bottom: 18px;
			}

			.section-title {
				margin: 0;
				color: #111;
				font-size: 1.8rem;
			}

			.section-desc {
				margin: 6px 0 0;
				color: #666;
				font-size: 0.96rem;
				line-height: 1.7;
			}

			.panel,
			.paper-card,
			.empty-state {
				border: 1px solid #eee;
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
				min-width: 0;
			}

			.panel {
				overflow: hidden;
			}

			.panel-header,
			.panel-body {
				padding: 22px;
			}

			.panel-header {
				border-bottom: 1px solid #eee;
			}

			.panel-title {
				margin: 0;
				color: #111;
				font-size: 1.18rem;
			}

			.panel-desc,
			.status-message,
			.help-text {
				margin: 8px 0 0;
				color: #666;
				font-size: 0.94rem;
				line-height: 1.7;
			}

			.analyzer-grid {
				display: grid;
				grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
				gap: 24px;
				align-items: start;
			}

			.form-grid {
				display: grid;
				gap: 16px;
			}

			.field {
				display: grid;
				gap: 8px;
			}

			label {
				color: #333;
				font-size: 0.9rem;
				font-weight: 700;
			}

			input,
			select,
			textarea {
				width: 100%;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #fff;
				color: #111;
				font: inherit;
				font-size: 0.95rem;
				line-height: 1.55;
			}

			input,
			select {
				min-height: 42px;
				padding: 9px 12px;
			}

			textarea {
				min-height: 260px;
				padding: 12px;
				resize: vertical;
			}

			input:focus,
			select:focus,
			textarea:focus {
				outline: 2px solid #111;
				outline-offset: 2px;
				border-color: #111;
			}

			.upload-box {
				border: 1px dashed #d1d5db;
				border-radius: 8px;
				padding: 16px;
				background: #fafafa;
			}

			.mode-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 10px;
			}

			.mode-button,
			.button,
			.search-btn,
			.page-btn,
			.preset-button,
			.platform-link,
			.btn-copy,
			.btn-open,
			.btn-save,
			.btn-analyze {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #e5e7eb;
				border-radius: 999px;
				background: #fff;
				color: #333;
				font: inherit;
				font-size: 0.92rem;
				font-weight: 700;
				text-decoration: none;
				cursor: pointer;
				min-height: 44px;
				max-width: 100%;
				text-align: center;
				overflow-wrap: anywhere;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
			}

			.mode-button {
				min-height: 44px;
				padding: 9px 12px;
			}

			.platform-link,
			.preset-button {
				min-height: 38px;
				padding: 8px 12px;
			}

			.mode-button:hover,
			.button:hover,
			.search-btn:hover,
			.page-btn:hover:not(:disabled),
			.preset-button:hover,
			.platform-link:hover,
			.btn-copy:hover,
			.btn-open:hover,
			.btn-save:hover,
			.btn-analyze:hover {
				background: #f3f4f6;
				border-color: #d1d5db;
				transform: translateY(-2px);
			}

			.mode-button.active,
			.button-primary,
			.search-btn,
			.btn-save,
			.btn-analyze {
				background: #111;
				border-color: #111;
				color: #fff;
			}

			.mode-button.active:hover,
			.button-primary:hover,
			.search-btn:hover,
			.btn-save:hover,
			.btn-analyze:hover {
				background: #333;
				border-color: #333;
			}

			.button-row,
			.action-btns {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}

			.output-view {
				min-height: 520px;
				padding: 24px;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #fcfcfc;
				color: #222;
				line-height: 1.85;
				overflow-wrap: break-word;
			}

			.output-view h2,
			.output-view h3 {
				color: #111;
				line-height: 1.35;
			}

			.output-view h2 {
				margin: 0 0 18px;
				font-size: 1.4rem;
			}

			.output-view h3 {
				margin: 26px 0 10px;
				font-size: 1.05rem;
			}

			.output-view p,
			.output-view ul,
			.output-view ol {
				margin: 0 0 16px;
			}

			.output-view ul,
			.output-view ol {
				padding-left: 1.2rem;
			}

			.output-placeholder {
				color: #777;
			}

			.search-box {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 16px;
				align-items: center;
			}

			.query-presets,
			.platform-links {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 16px;
			}

			.search-input {
				flex: 1;
				min-width: 250px;
				padding: 16px 20px;
				font-size: 1.05rem;
				border-radius: 999px;
				background-color: #fcfcfc;
			}

			.sort-select {
				width: auto;
				min-width: 220px;
				padding: 14px 18px;
				border-radius: 999px;
				background-color: #fcfcfc;
			}

			.year-select {
				width: auto;
				min-width: 150px;
				padding: 14px 18px;
				border-radius: 999px;
				background-color: #fcfcfc;
			}

			.search-btn {
				min-height: 50px;
				padding: 13px 24px;
			}

			.oa-toggle {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 24px;
				color: #555;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
			}

			.oa-toggle input {
				width: 18px;
				height: 18px;
				cursor: pointer;
			}

			.paper-list {
				display: grid;
				gap: 20px;
			}

			.paper-card {
				padding: 26px;
			}

			.card-header {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				margin-bottom: 16px;
				min-width: 0;
			}

			.paper-title {
				margin: 0 0 10px;
				color: #111;
				font-size: 1.35rem;
				line-height: 1.4;
				overflow-wrap: anywhere;
			}

			.paper-subtitle,
			.paper-abstract,
			.recommend-list,
			.empty-state {
				color: #555;
				line-height: 1.75;
				overflow-wrap: break-word;
			}

			.paper-subtitle {
				margin: 0;
				font-size: 0.94rem;
			}

			.paper-abstract {
				margin: 0 0 18px;
			}

			.score-badge {
				flex: 0 0 auto;
				min-width: 72px;
				border-radius: 8px;
				background: #111;
				color: #fff;
				padding: 12px 14px;
				text-align: center;
			}

			.score-number {
				display: block;
				font-size: 1.5rem;
				font-weight: 800;
				line-height: 1;
			}

			.score-label {
				display: block;
				margin-top: 4px;
				font-size: 0.76rem;
				opacity: 0.78;
			}

			.pill-row {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 16px;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				background: #f3f4f6;
				color: #444;
				padding: 7px 10px;
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1.2;
				max-width: 100%;
				overflow-wrap: anywhere;
			}

			.pill-dark {
				background: #111;
				color: #fff;
			}

			.recommend-list {
				margin: 0 0 18px;
				padding-left: 1.2rem;
			}

			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 8px;
				margin-top: 36px;
				flex-wrap: wrap;
			}

			.page-btn {
				min-height: 38px;
				padding: 8px 14px;
				border-radius: 8px;
			}

			.page-btn.active {
				background: #111;
				color: #fff;
				border-color: #111;
			}

			.page-btn:disabled {
				opacity: 0.45;
				cursor: not-allowed;
				transform: none;
			}

			.status-message {
				margin-bottom: 24px;
				font-weight: 700;
			}

			.save-status {
				min-height: 1.4em;
				margin: 10px 0 0;
				color: #555;
				font-size: 0.9rem;
				font-weight: 700;
			}

			.save-status.success {
				color: #255525;
			}

			.save-status.error {
				color: #7a2626;
			}

			@media (max-width: 860px) {
				.analyzer-grid {
					grid-template-columns: 1fr;
				}

				.mode-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				main {
					padding: 32px 16px;
				}

				.page-title {
					font-size: 2.35rem;
					line-height: 1.12;
				}

				.page-desc {
					font-size: 1rem;
					line-height: 1.7;
				}

				.section {
					margin-bottom: 42px;
				}

				.section-title {
					font-size: 1.35rem;
				}

				.section-heading,
				.card-header {
					flex-direction: column;
					align-items: flex-start;
					gap: 12px;
				}

				.panel-header,
				.panel-body,
				.paper-card {
					padding: 18px;
				}

				.button-row,
				.action-btns,
				.page-actions,
				.query-presets,
				.platform-links {
					gap: 8px;
				}

				.button-row > *,
				.action-btns > *,
				.page-actions > *,
				.query-presets > *,
				.platform-links > * {
					flex: 1 1 calc(50% - 8px);
				}

				.search-box {
					flex-direction: column;
					align-items: stretch;
				}

				.search-input {
					min-width: 0;
					width: 100%;
					padding: 13px 16px;
					border-radius: 16px;
					font-size: 1rem;
				}

				.sort-select {
					width: 100%;
					min-width: 0;
					padding: 12px 14px;
				}

				.year-select {
					width: 100%;
					min-width: 0;
					padding: 12px 14px;
				}

				.search-btn {
					width: 100%;
				}

				.output-view {
					min-height: 320px;
					padding: 18px;
				}

				.score-badge {
					align-self: flex-start;
					min-width: 0;
				}
			}

			@media (max-width: 360px) {
				main {
					padding-right: 14px;
					padding-left: 14px;
				}

				.button-row > *,
				.action-btns > *,
				.page-actions > *,
				.query-presets > *,
				.platform-links > * {
					flex-basis: 100%;
				}

				.panel-header,
				.panel-body,
				.paper-card,
				.output-view {
					padding: 16px;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<h1 class="page-title">文獻總結系統</h1>
			<p class="page-desc">
				上傳或貼上一篇論文內容，先用八種固定視角做快速整理；也可以繼續用 OpenAlex 搜尋下一篇文獻。
			</p>

			<div class="page-actions">
				<a href="/papers" class="button">我的文獻庫</a>
				<a href="/dashboard" class="button">回到儀表板</a>
			</div>

			<section class="section" aria-labelledby="analyzerTitle">
				<div class="section-heading">
					<div>
						<h2 id="analyzerTitle" class="section-title">Paper Lens 分析</h2>
						<p class="section-desc">
							目前是瀏覽器端規則式整理，適合先產生讀書會、報告與研究筆記大綱。
						</p>
					</div>
				</div>

				<div class="analyzer-grid">
					<section class="panel" aria-labelledby="inputTitle">
						<div class="panel-header">
							<h3 class="panel-title" id="inputTitle">論文內容</h3>
							<p class="panel-desc">
								可上傳 txt、md、html 或嘗試讀取 pdf；若 PDF 文字被壓縮，請直接貼上摘要或全文。
							</p>
						</div>
						<div class="panel-body">
							<div class="form-grid">
								<div class="upload-box">
									<label for="paperFile">上傳論文檔案</label>
									<input id="paperFile" type="file" accept=".txt,.md,.html,.htm,.pdf,text/*,application/pdf" />
									<p class="help-text" id="fileStatus">尚未選擇檔案。</p>
								</div>

								<div class="field">
									<label for="paperTitle">論文標題</label>
									<input id="paperTitle" type="text" placeholder="可手動填入，或從搜尋結果帶入" />
								</div>

								<div class="field">
									<label for="paperCitation">引用資訊</label>
									<input id="paperCitation" type="text" placeholder="作者、年份、期刊、DOI" />
								</div>

								<div class="field">
									<label for="paperText">論文文字</label>
									<textarea id="paperText" placeholder="貼上 abstract、introduction、methods、results 或全文。"></textarea>
								</div>

								<div class="field">
									<label>分析方式</label>
									<div class="mode-grid" id="modeGrid"></div>
								</div>

								<div class="button-row">
									<button type="button" class="button button-primary" id="analyzeButton">
										產生分析
									</button>
									<button type="button" class="button" id="copyPromptButton">
										複製分析提示
									</button>
								</div>
							</div>
						</div>
					</section>

					<section class="panel" aria-labelledby="outputTitle">
						<div class="panel-header">
							<h3 class="panel-title" id="outputTitle">分析結果</h3>
							<p class="panel-desc">
								結果可以直接複製成 Markdown，或下載後再整理到研究筆記。
							</p>
						</div>
						<div class="panel-body">
							<div class="button-row">
								<button type="button" class="button" id="copyMarkdownButton">
									複製 Markdown
								</button>
								<button type="button" class="button" id="downloadMarkdownButton">
									下載結果
								</button>
								<button type="button" class="button button-primary" id="saveAnalysisButton">
									儲存到文獻庫
								</button>
							</div>
							<p class="save-status" id="saveAnalysisStatus" aria-live="polite"></p>
							<div class="output-view" id="analysisOutput">
								<p class="output-placeholder">
									選擇分析方式後按下「產生分析」，這裡會顯示摘要、關鍵概念與可追問的研究問題。
								</p>
							</div>
						</div>
					</section>
				</div>
			</section>

			<section class="section" aria-labelledby="searchTitle">
				<div class="section-heading">
					<div>
						<h2 id="searchTitle" class="section-title">OpenAlex 文獻搜尋</h2>
						<p class="section-desc">
							用研究主題搜尋文獻，找到候選文章後可把摘要帶入上方分析器。
						</p>
					</div>
				</div>

				<div class="query-presets" aria-label="常用研究主題">
					<button type="button" class="preset-button" data-query="high entropy alloy density functional theory catalysis">
						HEA + DFT + catalysis
					</button>
					<button type="button" class="preset-button" data-query="oxygen evolution reaction high entropy alloy">
						OER 高熵合金
					</button>
					<button type="button" class="preset-button" data-query="hydrogen evolution reaction density functional theory">
						HER + DFT
					</button>
					<button type="button" class="preset-button" data-query="VASP adsorption energy surface catalysis">
						VASP adsorption
					</button>
				</div>

				<div class="search-box">
					<input
						type="text"
						id="paperSearchInput"
						class="search-input"
						placeholder="例如: VASP surface adsorption, density functional theory"
					/>
					<select id="sortSelect" class="sort-select">
						<option value="relevance_score:desc">依關聯度排序</option>
						<option value="cited_by_count:desc">依引用次數排序</option>
						<option value="publication_year:desc">依年份排序</option>
					</select>
					<select id="yearSelect" class="year-select">
						<option value="all">全部年份</option>
						<option value="5">近 5 年</option>
						<option value="10">近 10 年</option>
					</select>
					<button id="searchBtn" class="search-btn">搜尋論文</button>
				</div>

				<div class="platform-links" aria-label="外部文獻平台">
					<a class="platform-link" data-platform-link="scholar" href="https://scholar.google.com/" target="_blank" rel="noreferrer">
						Google Scholar
					</a>
					<a class="platform-link" data-platform-link="semantic" href="https://www.semanticscholar.org/" target="_blank" rel="noreferrer">
						Semantic Scholar
					</a>
					<a class="platform-link" data-platform-link="crossref" href="https://search.crossref.org/" target="_blank" rel="noreferrer">
						Crossref
					</a>
				</div>

				<label class="oa-toggle">
					<input type="checkbox" id="oaCheckbox" />
					<span>只顯示可免費下載的公開文獻</span>
				</label>

				<p id="statusMsg" class="status-message"></p>
				<div id="paperResults" class="paper-list"></div>
				<div id="paginationContainer" class="pagination"></div>
			</section>
		</main>

		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const modes = [
					{
						id: 'quick',
						label: '五分鐘速覽',
						prompt: '請用五分鐘速覽方式整理這篇論文：研究問題、方法、主要發現、限制與我下一步該讀哪裡。',
					},
					{
						id: 'prereq',
						label: '先備知識健檢',
						prompt: '請列出讀懂這篇論文需要的先備知識，分成已知、需要補強與建議查詢關鍵字。',
					},
					{
						id: 'plain',
						label: '白話重建',
						prompt: '請用研究生能快速理解的白話重建這篇論文，避免只翻譯摘要。',
					},
					{
						id: 'concept',
						label: '概念地圖',
						prompt: '請把這篇論文整理成概念地圖：核心概念、材料/方法、變因、結果與關係。',
					},
					{
						id: 'method',
						label: '方法復現',
						prompt: '請用復現工程師視角整理這篇論文：資料、計算條件、步驟、參數與容易漏掉的細節。',
					},
					{
						id: 'reviewer',
						label: '二號審稿人',
						prompt: '請用嚴格審稿人角度指出這篇論文的假設、證據缺口、替代解釋與需要補的實驗或計算。',
					},
					{
						id: 'followup',
						label: '後續研究題目',
						prompt: '請根據這篇論文提出後續研究題目，包含可執行問題、所需資料與預期貢獻。',
					},
					{
						id: 'talk',
						label: '讀書會報告',
						prompt: '請把這篇論文整理成讀書會報告大綱，包含開場、方法、圖表討論、批判與討論題。',
					},
				];

				const refs = {
					modeGrid: document.querySelector('#modeGrid'),
					paperFile: document.querySelector('#paperFile'),
					fileStatus: document.querySelector('#fileStatus'),
					paperTitle: document.querySelector('#paperTitle'),
					paperCitation: document.querySelector('#paperCitation'),
					paperText: document.querySelector('#paperText'),
					analyzeButton: document.querySelector('#analyzeButton'),
					copyPromptButton: document.querySelector('#copyPromptButton'),
					copyMarkdownButton: document.querySelector('#copyMarkdownButton'),
					downloadMarkdownButton: document.querySelector('#downloadMarkdownButton'),
					saveAnalysisButton: document.querySelector('#saveAnalysisButton'),
					saveAnalysisStatus: document.querySelector('#saveAnalysisStatus'),
					analysisOutput: document.querySelector('#analysisOutput'),
					searchInput: document.querySelector('#paperSearchInput'),
					sortSelect: document.querySelector('#sortSelect'),
					yearSelect: document.querySelector('#yearSelect'),
					oaCheckbox: document.querySelector('#oaCheckbox'),
					searchBtn: document.querySelector('#searchBtn'),
					statusMsg: document.querySelector('#statusMsg'),
					resultsContainer: document.querySelector('#paperResults'),
					paginationContainer: document.querySelector('#paginationContainer'),
				};

				if (!Object.values(refs).every(Boolean)) return;

				let activeMode = modes[0].id;
				let currentMarkdown = '';
				let currentQuery = '';
				let currentSort = '';
				let currentYearWindow = 'all';
				let currentIsOa = false;
				let currentPaperPayload = null;

				const escapeHtml = (value) =>
					String(value)
						.replaceAll('&', '&amp;')
						.replaceAll('<', '&lt;')
						.replaceAll('>', '&gt;')
						.replaceAll('"', '&quot;')
						.replaceAll("'", '&#039;');

				const setFileStatus = (message) => {
					refs.fileStatus.textContent = message;
				};

				const setSearchStatus = (message) => {
					refs.statusMsg.textContent = message;
				};

				const setSaveStatus = (message, type = '') => {
					refs.saveAnalysisStatus.textContent = message;
					refs.saveAnalysisStatus.classList.toggle('success', type === 'success');
					refs.saveAnalysisStatus.classList.toggle('error', type === 'error');
				};

				const splitQueryTags = (value) =>
					value
						.split(/[,\s]+/u)
						.map((tag) => tag.trim())
						.filter((tag) => tag.length >= 3)
						.slice(0, 8);

				const uniqueTags = (items) =>
					items
						.map((item) => String(item || '').trim())
						.filter((item, index, list) => item && list.indexOf(item) === index)
						.slice(0, 24);

				const createSlug = (value) =>
					String(value || '')
						.trim()
						.toLowerCase()
						.replace(/[^\p{Letter}\p{Number}]+/gu, '-')
						.replace(/^-+|-+$/g, '')
						.slice(0, 90);

				const splitSentences = (text) =>
					text
						.replace(/\s+/g, ' ')
						.split(/(?<=[.!?。！？])\s+/u)
						.map((sentence) => sentence.trim())
						.filter((sentence) => sentence.length > 40);

				const extractKeywords = (text) => {
					const stopWords = new Set([
						'the',
						'and',
						'for',
						'with',
						'that',
						'this',
						'from',
						'were',
						'have',
						'has',
						'are',
						'was',
						'using',
						'study',
						'research',
						'paper',
						'results',
						'method',
						'方法',
						'研究',
						'結果',
						'本文',
						'論文',
					]);
					const words = text.match(/[\p{Letter}\p{Number}][\p{Letter}\p{Number}-]{2,}/gu) ?? [];
					const counts = new Map();

					for (const rawWord of words) {
						const word = rawWord.toLowerCase();
						if (stopWords.has(word)) continue;
						counts.set(word, (counts.get(word) ?? 0) + 1);
					}

					return [...counts.entries()]
						.sort((a, b) => b[1] - a[1])
						.slice(0, 12)
						.map(([word]) => word);
				};

				const pickSentences = (text, keywords, limit) => {
					const sentences = splitSentences(text);
					const scored = sentences.map((sentence, index) => {
						const lower = sentence.toLowerCase();
						const score = keywords.reduce(
							(total, keyword) => total + (lower.includes(keyword) ? 1 : 0),
							0,
						);
						return { sentence, score: score * 10 - index };
					});

					const selected = scored
						.sort((a, b) => b.score - a.score)
						.slice(0, limit)
						.map((item) => item.sentence);

					return selected.length > 0 ? selected : sentences.slice(0, limit);
				};

				const findSection = (text, names) => {
					const lower = text.toLowerCase();
					for (const name of names) {
						const start = lower.indexOf(name.toLowerCase());
						if (start >= 0) {
							const nextHeading = lower.slice(start + name.length).search(/\n\s*[0-9]?\s*[a-z ]{4,30}\n/i);
							const end =
								nextHeading > 0
									? start + name.length + nextHeading
									: start + 1800;
							return text.slice(start, end).replace(/\s+/g, ' ').trim();
						}
					}

					return '';
				};

				const createContext = () => {
					const text = refs.paperText.value.trim();
					const title = refs.paperTitle.value.trim() || '未命名論文';
					const citation = refs.paperCitation.value.trim() || '尚未填寫引用資訊';
					const keywords = extractKeywords(text);
					const keySentences = pickSentences(text, keywords, 7);
					const abstract = findSection(text, ['abstract', '摘要']) || keySentences[0] || '';
					const methods = findSection(text, [
						'methods',
						'methodology',
						'experimental',
						'computational details',
						'方法',
						'計算細節',
					]);
					const conclusion = findSection(text, [
						'conclusion',
						'conclusions',
						'discussion',
						'結論',
						'討論',
					]);

					return {
						text,
						title,
						citation,
						keywords,
						keySentences,
						abstract,
						methods,
						conclusion,
					};
				};

				const bulletList = (items, fallback) => {
					const values = items.filter(Boolean);
					if (values.length === 0) return `- ${fallback}`;
					return values.map((item) => `- ${item}`).join('\n');
				};

				const createQuickScan = (context) => `## ${context.title}

### 五分鐘速覽
- 引用資訊：${context.citation}
- 核心關鍵字：${context.keywords.slice(0, 8).join('、') || '尚未抓到明確關鍵字'}

### 研究問題
${bulletList(context.keySentences.slice(0, 2), '先從摘要與 introduction 找出作者真正要回答的問題。')}

### 主要發現
${bulletList(context.keySentences.slice(2, 5), '目前文字不足，建議補上 results 或 conclusion 後再整理。')}

### 需要注意
- 先確認研究對象、實驗或計算條件是否與自己的題目相近。
- 讀圖表時優先看變因、對照組與作者用來支持結論的證據。`;

				const createPrereq = (context) => `## ${context.title}

### 先備知識健檢
- 主題詞：${context.keywords.slice(0, 10).join('、') || '尚未抓到明確主題詞'}

### 讀之前要先懂
${bulletList(
	context.keywords.slice(0, 5).map((keyword) => `確認「${keyword}」在此領域中的定義與常見用途。`),
	'先補充研究背景與關鍵術語。',
)}

### 建議查詢
${bulletList(
	context.keywords.slice(5, 10).map((keyword) => `${keyword} review paper`),
	'用論文標題加上 review、tutorial 或 benchmark 搜尋補充材料。',
)}

### 讀完自測
- 我能不能用三句話說明作者想解決什麼問題？
- 我能不能指出這篇論文最重要的一張圖或一組數據？
- 我能不能說明這個方法與我自己的研究有什麼關係？`;

				const createPlain = (context) => `## ${context.title}

### 白話重建
這篇論文可以先理解成：作者把一個研究問題拆成可測量或可計算的幾個部分，再用特定方法確認哪些因素最影響結果。

### 用自己的話說
${bulletList(context.keySentences.slice(0, 5), '目前文字不足，請貼上摘要、方法與結論後再重建。')}

### 我需要帶走的東西
- 這篇文章的真正價值不只是結論，而是它如何設計比較與驗證。
- 如果要接到自己的研究，優先整理材料系統、計算設定、資料處理方式與限制。`;

				const createConceptMap = (context) => `## ${context.title}

### 概念地圖
- 中心問題：${context.keySentences[0] || '尚未從文字中判斷。'}
- 主要概念：${context.keywords.slice(0, 6).join('、') || '尚未抓到明確概念'}
- 方法與工具：${context.methods || '尚未偵測到方法段落。'}
- 結果線索：${context.conclusion || context.keySentences[1] || '尚未偵測到結果或結論段落。'}

### 關係整理
${bulletList(
	context.keywords.slice(0, 5).map((keyword, index) => `${keyword} 可能是第 ${index + 1} 個需要放進筆記的概念節點。`),
	'先把材料、方法、結果、限制四類節點分開整理。',
)}`;

				const createMethod = (context) => `## ${context.title}

### 方法復現
- 引用資訊：${context.citation}

### 可復現資訊
${bulletList(
	context.methods ? [context.methods] : context.keySentences.slice(0, 3),
	'目前沒有抓到方法段落，請補上 methods、computational details 或 supporting information。',
)}

### 復現檢查清單
- 研究系統或樣品是否描述清楚。
- 計算或實驗參數是否足以重做。
- 是否有初始結構、資料集、程式碼或 supplementary information。
- 輸出結果是否有和圖表、表格或文中數值互相對應。`;

				const createReviewer = (context) => `## ${context.title}

### 二號審稿人視角

### 目前支持結論的證據
${bulletList(context.keySentences.slice(0, 4), '目前文字不足，請補上 results 或 discussion。')}

### 可能的疑問
- 作者是否排除了其他解釋？
- 方法設定是否足以支持最強的結論？
- 樣本、材料或計算條件是否太窄？
- 結論是否有超出數據能支撐的範圍？

### 可以補強的驗證
- 增加對照組或 benchmark。
- 補敏感度測試或參數掃描。
- 把關鍵圖表與原始數據連起來檢查。`;

				const createFollowup = (context) => `## ${context.title}

### 後續研究題目
${bulletList(
	context.keywords.slice(0, 5).map((keyword) => `以 ${keyword} 為核心，設計一個更小範圍、可驗證的延伸問題。`),
	'先從作者的限制與未完成問題中挑一個可執行題目。',
)}

### 可以立刻做的小步驟
- 建立相關文獻清單，分成背景、方法、benchmark 三類。
- 把此論文的材料系統或計算條件轉成自己的任務。
- 針對一個關鍵圖表寫出「如果我要重做，需要哪些資料」。`;

				const createTalk = (context) => `## ${context.title}

### 讀書會報告大綱
1. 開場：這篇論文想回答什麼問題。
2. 背景：為什麼這個問題值得研究。
3. 方法：作者如何設計實驗或計算。
4. 結果：最重要的圖表與證據。
5. 批判：限制、假設與可能替代解釋。
6. 延伸：這篇論文可以如何接到我的研究。

### 可直接放進簡報的重點
${bulletList(context.keySentences.slice(0, 5), '目前文字不足，請補上摘要與結論後再產生重點。')}

### 討論題
- 這篇論文最強的證據是哪一個？
- 如果要重做，最容易卡住的部分是什麼？
- 對我的研究題目而言，最值得借用的是方法、材料還是分析邏輯？`;

				const analyzers = {
					quick: createQuickScan,
					prereq: createPrereq,
					plain: createPlain,
					concept: createConceptMap,
					method: createMethod,
					reviewer: createReviewer,
					followup: createFollowup,
					talk: createTalk,
				};

				const markdownToHtml = (markdown) => {
					const lines = markdown.split('\n');
					let html = '';
					let inList = false;

					const closeList = () => {
						if (inList) {
							html += '</ul>';
							inList = false;
						}
					};

					for (const line of lines) {
						const trimmed = line.trim();
						if (!trimmed) {
							closeList();
							continue;
						}

						if (trimmed.startsWith('### ')) {
							closeList();
							html += `<h3>${escapeHtml(trimmed.slice(4))}</h3>`;
							continue;
						}

						if (trimmed.startsWith('## ')) {
							closeList();
							html += `<h2>${escapeHtml(trimmed.slice(3))}</h2>`;
							continue;
						}

						if (/^\d+\.\s/.test(trimmed)) {
							closeList();
							html += `<p>${escapeHtml(trimmed)}</p>`;
							continue;
						}

						if (trimmed.startsWith('- ')) {
							if (!inList) {
								html += '<ul>';
								inList = true;
							}
							html += `<li>${escapeHtml(trimmed.slice(2))}</li>`;
							continue;
						}

						closeList();
						html += `<p>${escapeHtml(trimmed)}</p>`;
					}

					closeList();
					return html;
				};

				const renderModes = () => {
					for (const mode of modes) {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = `mode-button ${mode.id === activeMode ? 'active' : ''}`;
						button.dataset.mode = mode.id;
						button.setAttribute('aria-pressed', String(mode.id === activeMode));
						button.textContent = mode.label;
						refs.modeGrid.append(button);
					}
				};

				const updateModeButtons = () => {
					refs.modeGrid.querySelectorAll('[data-mode]').forEach((button) => {
						const isActive = button.dataset.mode === activeMode;
						button.classList.toggle('active', isActive);
						button.setAttribute('aria-pressed', String(isActive));
					});
				};

				const analyze = () => {
					const context = createContext();
					if (context.text.length < 120) {
						currentMarkdown = '';
						refs.analysisOutput.innerHTML =
							'<p class="output-placeholder">請先上傳或貼上更多論文文字，至少包含摘要或主要段落。</p>';
						return;
					}

					currentMarkdown = analyzers[activeMode](context);
					refs.analysisOutput.innerHTML = markdownToHtml(currentMarkdown);
				};

				const copyText = async (text, successMessage) => {
					if (!text) return;
					await navigator.clipboard.writeText(text);
					setFileStatus(successMessage);
				};

				const activePrompt = () => {
					const mode = modes.find((item) => item.id === activeMode) ?? modes[0];
					return `${mode.prompt}\n\n論文標題：${refs.paperTitle.value.trim() || '未命名論文'}\n引用資訊：${refs.paperCitation.value.trim() || '尚未填寫'}\n\n論文內容：\n${refs.paperText.value.trim()}`;
				};

				const activeModeLabel = () =>
					(modes.find((item) => item.id === activeMode) ?? modes[0]).label;

				const savePaperPayload = async (payload, { button, statusElement } = {}) => {
					const originalText = button?.textContent || '';
					if (button) {
						button.disabled = true;
						button.textContent = '儲存中';
					}
					if (statusElement) {
						statusElement.textContent = '儲存中。';
						statusElement.classList.remove('success', 'error');
					}

					try {
						const response = await fetch('/api/admin/papers', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify(payload),
						});
						const result = await response.json();
						if (!response.ok || !result.ok) {
							throw new Error(result.message || result.error || 'Save failed.');
						}

						if (statusElement) {
							statusElement.textContent = '已儲存到我的文獻庫。';
							statusElement.classList.add('success');
						}
						if (button) button.textContent = '已儲存';

						window.setTimeout(() => {
							if (button) button.textContent = originalText;
						}, 1600);

						return result.paper;
					} catch {
						if (statusElement) {
							statusElement.textContent = '儲存失敗，請確認已登入本人帳號。';
							statusElement.classList.add('error');
						}
						if (button) button.textContent = '需登入';
						window.setTimeout(() => {
							if (button) button.textContent = originalText;
						}, 1800);
						return null;
					} finally {
						if (button) button.disabled = false;
					}
				};

				const buildCurrentPaperPayload = () => {
					const text = refs.paperText.value.trim();
					const context = createContext();
					const title = refs.paperTitle.value.trim() || currentPaperPayload?.title || '未命名論文';
					const citation = refs.paperCitation.value.trim() || currentPaperPayload?.citation || '';
					const keywordTags = extractKeywords(text).slice(0, 8);
					const basePayload = currentPaperPayload
						? { ...currentPaperPayload }
						: {
								source: 'manual',
								source_id: '',
								doi: '',
								title,
								authors: [],
								publication_year: null,
								journal: '',
								abstract: '',
								url: '',
								citation,
								cited_by_count: 0,
								is_open_access: false,
								reading_status: 'reading',
								tags: [],
								visibility: 'private',
							};

					return {
						...basePayload,
						title,
						citation,
						abstract: context.abstract || text.slice(0, 8000),
						reading_status: 'reading',
						tags: uniqueTags([...(basePayload.tags || []), ...keywordTags]),
						visibility: 'private',
						analysis: {
							analysis_mode: activeMode,
							analysis_title: activeModeLabel(),
							analysis_markdown: currentMarkdown,
							source_excerpt: text.slice(0, 40_000),
						},
					};
				};

				const saveCurrentAnalysis = async () => {
					if (!currentMarkdown) {
						analyze();
					}

					if (!currentMarkdown) {
						setSaveStatus('請先貼上論文文字並產生分析。', 'error');
						return;
					}

					const payload = buildCurrentPaperPayload();
					const savedPaper = await savePaperPayload(payload, {
						button: refs.saveAnalysisButton,
						statusElement: refs.saveAnalysisStatus,
					});
					if (savedPaper) currentPaperPayload = { ...payload, source_id: savedPaper.source_id };
				};

				const downloadMarkdown = () => {
					if (!currentMarkdown) return;
					const blob = new Blob([currentMarkdown], { type: 'text/markdown;charset=utf-8' });
					const url = URL.createObjectURL(blob);
					const anchor = document.createElement('a');
					const filename = `${createSlug(refs.paperTitle.value) || 'paper-analysis'}.md`;
					anchor.href = url;
					anchor.download = filename;
					anchor.click();
					URL.revokeObjectURL(url);
				};

				const readPdfText = async (file) => {
					const buffer = await file.arrayBuffer();
					const bytes = new Uint8Array(buffer);
					let binary = '';
					const chunkSize = 16_384;

					for (let index = 0; index < bytes.length; index += chunkSize) {
						binary += String.fromCharCode(...bytes.slice(index, index + chunkSize));
					}

					const literalMatches = [...binary.matchAll(/\(([^()]{12,})\)/g)]
						.map((match) => match[1])
						.join(' ');
					return literalMatches
						.replace(/\\([()\\])/g, '$1')
						.replace(/\\n|\\r/g, ' ')
						.replace(/[^\x09\x0a\x0d\x20-\uFFFF]/g, ' ')
						.replace(/\s+/g, ' ')
						.trim();
				};

				const readFile = async (file) => {
					if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
						const text = await readPdfText(file);
						if (text.length < 400) {
							setFileStatus('PDF 文字可能被壓縮，建議改貼上全文或摘要。');
						} else {
							setFileStatus(`已讀取 PDF：${file.name}`);
						}
						return text;
					}

					setFileStatus(`已讀取檔案：${file.name}`);
					return file.text();
				};

				refs.modeGrid.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					const button = target.closest('[data-mode]');
					if (!(button instanceof HTMLElement)) return;
					activeMode = button.dataset.mode || modes[0].id;
					updateModeButtons();
					if (refs.paperText.value.trim()) analyze();
				});

				refs.paperFile.addEventListener('change', () => {
					const file = refs.paperFile.files?.[0];
					if (!file) return;

					readFile(file)
						.then((text) => {
							refs.paperText.value = text;
							currentPaperPayload = null;
							if (!refs.paperTitle.value.trim()) {
								refs.paperTitle.value = file.name.replace(/\.[^.]+$/, '');
							}
						})
						.catch(() => {
							setFileStatus('檔案讀取失敗，請改用貼上文字。');
						});
				});

				refs.analyzeButton.addEventListener('click', analyze);
				refs.copyMarkdownButton.addEventListener('click', () => {
					copyText(currentMarkdown, 'Markdown 已複製。');
				});
				refs.copyPromptButton.addEventListener('click', () => {
					copyText(activePrompt(), '分析提示已複製。');
				});
				refs.downloadMarkdownButton.addEventListener('click', downloadMarkdown);
				refs.saveAnalysisButton.addEventListener('click', saveCurrentAnalysis);
				refs.paperTitle.addEventListener('input', () => {
					currentPaperPayload = null;
				});
				refs.paperCitation.addEventListener('input', () => {
					currentPaperPayload = null;
				});

				const reconstructAbstract = (invertedIndex) => {
					if (!invertedIndex) return '此篇文獻未提供摘要資料。';
					const words = [];

					for (const [word, positions] of Object.entries(invertedIndex)) {
						for (const position of positions) {
							words[position] = word;
						}
					}

					return words.join(' ');
				};

				const generateCitation = (paper) => {
					let authors = 'Unknown Author';
					if (Array.isArray(paper.authorships) && paper.authorships.length > 0) {
						authors = paper.authorships
							.slice(0, 5)
							.map((item) => item.author?.display_name)
							.filter(Boolean)
							.join(', ');
						if (paper.authorships.length > 5) authors += ' et al.';
					}

					const year = paper.publication_year || 'n.d.';
					const title = paper.title || 'Untitled';
					const journal = paper.primary_location?.source?.display_name || '';
					const doi = paper.doi ? ` ${paper.doi}` : '';
					return `${authors} (${year}). ${title}. ${journal ? `${journal}.` : ''}${doi}`;
				};

				const extractAuthors = (paper) => {
					if (!Array.isArray(paper.authorships)) return [];

					return paper.authorships
						.map((item) => item.author?.display_name)
						.filter(Boolean)
						.slice(0, 40);
				};

				const extractConceptTags = (paper) => {
					if (!Array.isArray(paper.concepts)) return [];

					return paper.concepts
						.map((concept) => concept.display_name)
						.filter(Boolean)
						.slice(0, 6);
				};

				const getPaperLink = (paper) =>
					paper.primary_location?.landing_page_url || paper.doi || paper.id || '';

				const buildSearchPaperPayload = (paper, abstractText, citationText) => {
					const queryTags = splitQueryTags(currentQuery);
					const conceptTags = extractConceptTags(paper);

					return {
						source: 'openalex',
						source_id: paper.id || '',
						doi: paper.doi || '',
						title: paper.title || '無標題',
						authors: extractAuthors(paper),
						publication_year: paper.publication_year || null,
						journal: paper.primary_location?.source?.display_name || '',
						abstract: abstractText === '此篇文獻未提供摘要資料。' ? '' : abstractText,
						url: getPaperLink(paper),
						citation: citationText,
						cited_by_count: paper.cited_by_count || 0,
						is_open_access: Boolean(paper.open_access?.is_oa),
						reading_status: 'to_read',
						tags: uniqueTags([...queryTags, ...conceptTags]),
						visibility: 'private',
					};
				};

				const generateRecommendations = (paper, index, pageNumber) => {
					const reasons = [];
					if (pageNumber === 1 && index < 3 && currentSort.includes('relevance')) {
						reasons.push('搜尋主題高度相關，適合優先閱讀。');
					}
					if ((paper.cited_by_count || 0) > 500) {
						reasons.push('引用次數高，可能是領域代表或常用背景文獻。');
					}
					if ((paper.publication_year || 0) >= 2024) {
						reasons.push('年份較新，適合掌握近期研究方向。');
					}
					if (paper.open_access?.is_oa) {
						reasons.push('Open Access，可優先取得全文。');
					}
					if (reasons.length === 0) reasons.push('符合目前搜尋條件，可作為延伸閱讀候選。');
					return reasons;
				};

				const calculateDisplayScore = (paper, overallIndex) => {
					let score = 94 - overallIndex * 0.45;
					if ((paper.cited_by_count || 0) > 1000) score += 5;
					if (paper.open_access?.is_oa) score += 2;
					return Math.min(100, Math.max(50, Math.round(score)));
				};

				const renderPagination = (totalCount, currentPage) => {
					refs.paginationContainer.replaceChildren();
					if (totalCount === 0) return;

					const totalPages = Math.min(Math.ceil(totalCount / 10), 100);
					const startPage = Math.max(1, currentPage - 2);
					const endPage = Math.min(totalPages, startPage + 4);

					const createPageButton = (label, page, disabled = false, active = false) => {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = `page-btn ${active ? 'active' : ''}`;
						button.textContent = label;
						button.disabled = disabled;
						if (!disabled && !active) {
							button.addEventListener('click', () => {
								window.scrollTo({ top: 0, behavior: 'smooth' });
								searchPapers(page);
							});
						}
						return button;
					};

					refs.paginationContainer.append(
						createPageButton('上一頁', currentPage - 1, currentPage === 1),
					);

					for (let page = startPage; page <= endPage; page += 1) {
						refs.paginationContainer.append(
							createPageButton(String(page), page, false, page === currentPage),
						);
					}

					refs.paginationContainer.append(
						createPageButton('下一頁', currentPage + 1, currentPage === totalPages),
					);
				};

				const renderPaperCard = (paper, index, pageNumber) => {
					const card = document.createElement('article');
					card.className = 'paper-card';

					const title = paper.title || '無標題';
					const link = getPaperLink(paper) || '#';
					const year = paper.publication_year || '未知年份';
					const citedBy = paper.cited_by_count || 0;
					const journal = paper.primary_location?.source?.display_name || 'Unknown Journal';
					const abstractText = reconstructAbstract(paper.abstract_inverted_index);
					const citationText = generateCitation(paper);
					const paperPayload = buildSearchPaperPayload(paper, abstractText, citationText);
					const score = calculateDisplayScore(paper, (pageNumber - 1) * 10 + index);
					const reasons = generateRecommendations(paper, index, pageNumber);

					const header = document.createElement('div');
					header.className = 'card-header';

					const metaTop = document.createElement('div');
					const titleNode = document.createElement('h3');
					titleNode.className = 'paper-title';
					titleNode.textContent = title;
					const subtitle = document.createElement('p');
					subtitle.className = 'paper-subtitle';
					subtitle.textContent = `${year} · ${journal} · Citations: ${citedBy}`;
					metaTop.append(titleNode, subtitle);

					const scoreNode = document.createElement('div');
					scoreNode.className = 'score-badge';
					const scoreNumber = document.createElement('span');
					scoreNumber.className = 'score-number';
					scoreNumber.textContent = String(score);
					const scoreLabel = document.createElement('span');
					scoreLabel.className = 'score-label';
					scoreLabel.textContent = 'Score';
					scoreNode.append(scoreNumber, scoreLabel);
					header.append(metaTop, scoreNode);

					const pills = document.createElement('div');
					pills.className = 'pill-row';
					if (paper.open_access?.is_oa) {
						const oa = document.createElement('span');
						oa.className = 'pill pill-dark';
						oa.textContent = 'Open Access';
						pills.append(oa);
					}

					const abstract = document.createElement('p');
					abstract.className = 'paper-abstract';
					abstract.textContent = abstractText;

					const list = document.createElement('ul');
					list.className = 'recommend-list';
					for (const reason of reasons) {
						const item = document.createElement('li');
						item.textContent = reason;
						list.append(item);
					}

					const actions = document.createElement('div');
					actions.className = 'action-btns';
					const copyButton = document.createElement('button');
					copyButton.type = 'button';
					copyButton.className = 'btn-copy';
					copyButton.textContent = 'Copy Citation';
					copyButton.addEventListener('click', () => {
						navigator.clipboard.writeText(citationText);
						copyButton.textContent = '已複製';
						window.setTimeout(() => {
							copyButton.textContent = 'Copy Citation';
						}, 1600);
					});

					const analyzeButton = document.createElement('button');
					analyzeButton.type = 'button';
					analyzeButton.className = 'btn-analyze';
					analyzeButton.textContent = '帶入分析器';
					analyzeButton.addEventListener('click', () => {
						currentPaperPayload = paperPayload;
						refs.paperTitle.value = title;
						refs.paperCitation.value = citationText;
						refs.paperText.value = abstractText;
						analyze();
						document
							.querySelector('#analyzerTitle')
							?.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});

					const saveButton = document.createElement('button');
					saveButton.type = 'button';
					saveButton.className = 'btn-save';
					saveButton.textContent = '儲存文獻';
					saveButton.addEventListener('click', () => {
						savePaperPayload(paperPayload, { button: saveButton });
					});

					const openLink = document.createElement('a');
					openLink.className = 'btn-open';
					openLink.href = link;
					openLink.target = '_blank';
					openLink.rel = 'noreferrer';
					openLink.textContent = 'Open Paper';
					actions.append(copyButton, analyzeButton, saveButton, openLink);

					card.append(header);
					if (pills.childElementCount > 0) card.append(pills);
					card.append(abstract, list, actions);
					refs.resultsContainer.append(card);
				};

				const searchPapers = async (pageNumber = 1) => {
					if (pageNumber === 1) {
						currentQuery = refs.searchInput.value.trim();
						currentSort = refs.sortSelect.value;
						currentYearWindow = refs.yearSelect.value;
						currentIsOa = refs.oaCheckbox.checked;
					}

					if (!currentQuery) return;

					setSearchStatus('搜尋中，請稍候。');
					refs.resultsContainer.replaceChildren();
					refs.paginationContainer.replaceChildren();

					try {
						let url = `https://api.openalex.org/works?search=${encodeURIComponent(
							currentQuery,
						)}&per-page=10&page=${pageNumber}&sort=${encodeURIComponent(currentSort)}`;
						const filters = [];
						if (currentIsOa) filters.push('is_oa:true');
						if (currentYearWindow !== 'all') {
							const year = new Date().getFullYear() - Number(currentYearWindow) + 1;
							filters.push(`from_publication_date:${year}-01-01`);
						}
						if (filters.length > 0) url += `&filter=${filters.join(',')}`;

						const response = await fetch(url);
						const data = await response.json();
						const results = Array.isArray(data.results) ? data.results : [];

						if (results.length === 0) {
							setSearchStatus('找不到相關文獻，請嘗試更換關鍵字或取消 Open Access 篩選。');
							return;
						}

						const totalResults = data.meta?.count ?? results.length;
						setSearchStatus(
							`找到 ${totalResults.toLocaleString()} 筆相關文獻，目前顯示第 ${pageNumber} 頁。`,
						);

						results.forEach((paper, index) => renderPaperCard(paper, index, pageNumber));
						renderPagination(totalResults, pageNumber);
					} catch (error) {
						console.error('Failed to search OpenAlex.', error);
						setSearchStatus('連線至 OpenAlex 失敗，請稍後再試。');
					}
				};

				const updatePlatformLinks = () => {
					const query = refs.searchInput.value.trim();
					const encodedQuery = encodeURIComponent(query || 'high entropy alloy density functional theory catalysis');
					const links = document.querySelectorAll('[data-platform-link]');

					links.forEach((link) => {
						if (!(link instanceof HTMLAnchorElement)) return;

						if (link.dataset.platformLink === 'scholar') {
							link.href = `https://scholar.google.com/scholar?q=${encodedQuery}`;
						}
						if (link.dataset.platformLink === 'semantic') {
							link.href = `https://www.semanticscholar.org/search?q=${encodedQuery}&sort=relevance`;
						}
						if (link.dataset.platformLink === 'crossref') {
							link.href = `https://search.crossref.org/?q=${encodedQuery}`;
						}
					});
				};

				refs.searchBtn.addEventListener('click', () => searchPapers(1));
				refs.searchInput.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') searchPapers(1);
				});
				refs.searchInput.addEventListener('input', updatePlatformLinks);
				refs.sortSelect.addEventListener('change', () => {
					if (refs.searchInput.value.trim()) searchPapers(1);
				});
				refs.yearSelect.addEventListener('change', () => {
					if (refs.searchInput.value.trim()) searchPapers(1);
				});
				refs.oaCheckbox.addEventListener('change', () => {
					if (refs.searchInput.value.trim()) searchPapers(1);
				});
				document.querySelectorAll('[data-query]').forEach((button) => {
					if (!(button instanceof HTMLElement)) return;
					button.addEventListener('click', () => {
						refs.searchInput.value = button.dataset.query || '';
						updatePlatformLinks();
						searchPapers(1);
					});
				});

				const initialParams = new URLSearchParams(window.location.search);
				const initialTitle = initialParams.get('title');
				const initialCitation = initialParams.get('citation');
				if (initialTitle) {
					refs.paperTitle.value = initialTitle;
					refs.searchInput.value = initialTitle;
				}
				if (initialCitation) refs.paperCitation.value = initialCitation;

				renderModes();
				updatePlatformLinks();
			});
		</script>
	</body>
</html>
