---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = '未分類',
	tags = [],
	showToc = false,
	headings = [],
} = Astro.props;

const displayCategory = category || '未分類';
const visibleTags = tags.filter(Boolean);
const hasMetadata = Boolean(displayCategory || visibleTags.length > 0);

const getCategoryUrl = (categoryName: string) =>
	`/categories/${encodeURIComponent(categoryName)}/`;

const getTagUrl = (tag: string) => `/tags/${encodeURIComponent(tag)}/`;

const tocHeadings = headings.filter(
	(heading) =>
		heading.depth >= 2 &&
		heading.depth <= 3 &&
		heading.slug &&
		heading.text !== '快速導覽',
);

const hasToc = showToc && tocHeadings.length > 0;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />

		<style>
			main {
				width: 100%;
				margin: 0 auto;
			}

			.hero-image {
				width: 100%;
				max-width: 900px;
				margin: 0 auto 2em;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
				max-width: 100%;
				height: auto;
			}

			.prose {
				width: 100%;
				max-width: 720px;
				margin: auto;
				padding: 2em 1em;
				color: #111;
				line-height: 1.8;
				font-size: 1.1rem;
				overflow-wrap: break-word;
			}

			.title {
				margin-bottom: 2.5em;
				text-align: center;
				line-height: 1.2;
			}

			.title h1 {
				margin: 0.2em 0 0.5em;
				font-size: 3rem;
				font-weight: 800;
				letter-spacing: 0;
				overflow-wrap: anywhere;
			}

			.date {
				margin-bottom: 1em;
				color: #666;
				font-size: 0.95rem;
				letter-spacing: 0.05em;
			}

			.last-updated-on {
				font-style: normal;
				margin-top: 0.5em;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 8px;
				margin: 1em 0 1.5em;
			}

			.category,
			.tag {
				display: inline-flex;
				align-items: center;
				border-radius: 999px;
				font-size: 0.82rem;
				line-height: 1.2;
				padding: 7px 10px;
				text-decoration: none;
				max-width: 100%;
				overflow-wrap: anywhere;
				transition:
					background-color 0.2s ease,
					color 0.2s ease;
			}

			.category {
				background: #111;
				color: #fff;
			}

			.category:hover {
				background: #333;
				color: #fff;
			}

			.tag {
				background: #f3f4f6;
				color: #444;
			}

			.tag:hover {
				background: #e5e7eb;
				color: #111;
			}

			.prose :global(pre),
			.prose :global(pre.astro-code) {
				margin: 1.5em 0;
				padding: 16px 18px;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #f8fafc !important;
				color: #111 !important;
				overflow-x: auto;
				max-width: 100%;
				-webkit-overflow-scrolling: touch;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
			}

			.prose :global(pre code) {
				display: block;
				padding: 0;
				background: transparent !important;
				color: inherit !important;
				border-radius: 0;
				font-size: 0.95rem;
				line-height: 1.7;
				white-space: pre;
			}

			.prose :global(pre code span) {
				background: transparent !important;
				color: inherit !important;
			}

			.prose :global(:not(pre) > code) {
				color: #111;
				background: #f3f4f6;
			}

			.toc {
				margin: 0 0 2.5em;
				padding: 20px;
				border: 1px solid #e5e7eb;
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
			}

			.toc-title {
				margin: 0 0 14px;
				color: #111;
				font-size: 1rem;
				font-weight: 800;
			}

			.toc-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 8px 12px;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.toc-link {
				display: block;
				padding: 8px 10px;
				border-radius: 6px;
				color: #444;
				font-size: 0.92rem;
				line-height: 1.5;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					color 0.2s ease;
			}

			.toc-link:hover {
				background: #f3f4f6;
				color: #111;
			}

			.toc-depth-3 .toc-link {
				padding-left: 22px;
				color: #666;
				font-size: 0.88rem;
			}

			.prose :global(table) {
				display: block;
				width: 100%;
				margin: 1.5em 0;
				border-collapse: collapse;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				font-size: 0.95rem;
			}

			.prose :global(img),
			.prose :global(video) {
				max-width: 100%;
				height: auto;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 10px 12px;
				border: 1px solid #e5e7eb;
				text-align: left;
				vertical-align: top;
			}

			.prose :global(th) {
				background: #f8fafc;
				color: #111;
				font-weight: 800;
			}

			.prose :global(blockquote) {
				margin: 1.5em 0;
				padding: 0.1em 0 0.1em 1em;
				border-left: 4px solid #111;
				color: #333;
				font-weight: 600;
			}

			hr {
				border: none;
				border-top: 1px solid #eaeaea;
				margin: 2em 0;
			}

			@media (max-width: 720px) {
				.hero-image {
					margin-bottom: 1.2em;
					padding: 0 16px;
				}

				.prose {
					padding: 1.5em 16px;
					font-size: 1rem;
					line-height: 1.78;
				}

				.title {
					margin-bottom: 2em;
					text-align: left;
				}

				.title h1 {
					font-size: 2.05rem;
					line-height: 1.18;
				}

				.date {
					font-size: 0.9rem;
				}

				.post-meta {
					justify-content: flex-start;
					gap: 7px;
				}

				.toc {
					padding: 16px;
					margin-bottom: 2em;
				}

				.toc-list {
					grid-template-columns: 1fr;
					gap: 6px;
				}

				.toc-link {
					padding: 9px 8px;
					font-size: 0.9rem;
				}

				.toc-depth-3 .toc-link {
					padding-left: 18px;
				}

				.prose :global(pre),
				.prose :global(pre.astro-code) {
					padding: 14px;
					font-size: 0.92rem;
				}
			}

			@media (max-width: 360px) {
				.hero-image {
					padding: 0 14px;
				}

				.prose {
					padding-right: 14px;
					padding-left: 14px;
				}

				.title h1 {
					font-size: 1.82rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt={title}
							/>
						)
					}
				</div>

				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />

							{
								updatedDate && (
									<div class="last-updated-on">
										最後更新於
										{' '}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>

						<h1>{title}</h1>

						{
							hasMetadata && (
								<div class="post-meta">
									<a
										href={getCategoryUrl(displayCategory)}
										class="category"
									>
										{displayCategory}
									</a>

									{
										visibleTags.map((tag) => (
											<a href={getTagUrl(tag)} class="tag">
												{tag}
											</a>
										))
									}
								</div>
							)
						}

						<hr />
					</div>

					{
						hasToc && (
							<nav class="toc" aria-label="文章章節快速導覽">
								<p class="toc-title">快速導覽</p>
								<ol class="toc-list">
									{tocHeadings.map((heading) => (
										<li class={`toc-depth-${heading.depth}`}>
											<a class="toc-link" href={`#${heading.slug}`}>
												{heading.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}

					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>
